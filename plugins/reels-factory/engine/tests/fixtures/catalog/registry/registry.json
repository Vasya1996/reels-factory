{
  "$schema": "https://hyperframes.heygen.com/schema/registry.json",
  "name": "reels-factory-fixture",
  "homepage": "https://example.invalid",
  "items": [
    {
      "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
      "name": "count-up",
      "type": "hyperframes:component",
      "title": "Count Up",
      "description": "A token-native stat counter that eases between values and lands with a restrained scale pulse.",
      "tags": [
        "motion-primitive",
        "proof",
        "stats",
        "counter",
        "number"
      ],
      "duration": 3.0,
      "files": [
        {
          "path": "count-up.html",
          "target": "compositions/count-up.html",
          "type": "hyperframes:snippet"
        }
      ],
      "reels": {
        "kind": "effect",
        "variables": {
          "start": {
            "type": "number",
            "default": 0
          },
          "end": {
            "type": "number",
            "default": 100
          },
          "prefix": {
            "type": "string",
            "default": ""
          },
          "suffix": {
            "type": "string",
            "default": "%"
          },
          "accent": {
            "type": "enum",
            "default": "green"
          },
          "glow": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    {
      "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
      "name": "demo-host",
      "type": "hyperframes:block",
      "title": "Demo Host",
      "description": "Fixture position whose screen slot the framework expects from the host page",
      "tags": [
        "demo"
      ],
      "dimensions": {
        "width": 1080,
        "height": 1920
      },
      "duration": 4.0,
      "files": [
        {
          "path": "demo-host.html",
          "target": "compositions/demo-host.html",
          "type": "hyperframes:composition"
        }
      ],
      "reels": {
        "kind": "scene",
        "use_when": "Экран устройства, разметку которого даёт хостовая страница."
      }
    },
    {
      "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
      "name": "demo-media",
      "type": "hyperframes:block",
      "title": "Demo Media",
      "description": "Fixture position with one content slot the caller fills with a file",
      "tags": [
        "demo"
      ],
      "dimensions": {
        "width": 1080,
        "height": 1920
      },
      "duration": 4.0,
      "files": [
        {
          "path": "demo-media.html",
          "target": "compositions/demo-media.html",
          "type": "hyperframes:composition"
        }
      ],
      "reels": {
        "kind": "scene",
        "text_slots": [
          "chip"
        ],
        "use_when": "Сцене нужен кадр вставки в рамке — панель под файл."
      }
    },
    {
      "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
      "name": "demo-paste",
      "type": "hyperframes:component",
      "title": "Demo Paste",
      "description": "Fixture paste-contract effect for tests: a badge whose script reads window.__hyperframes.getVariables()",
      "tags": [
        "demo"
      ],
      "duration": 2.0,
      "files": [
        {
          "path": "demo-paste.html",
          "target": "compositions/components/demo-paste.html",
          "type": "hyperframes:snippet"
        }
      ],
      "reels": {
        "kind": "effect",
        "mount": "paste",
        "variables": {
          "label": {
            "type": "string",
            "default": "3"
          }
        }
      }
    },
    {
      "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
      "name": "demo-plain",
      "type": "hyperframes:block",
      "title": "Demo Plain",
      "description": "Yesterday's lower third: the card declares no kind",
      "tags": [
        "demo",
        "overlay"
      ],
      "dimensions": {
        "width": 1920,
        "height": 1080
      },
      "duration": 4.0,
      "files": [
        {
          "path": "demo-plain.html",
          "target": "compositions/demo-plain.html",
          "type": "hyperframes:composition"
        }
      ],
      "reels": {
        "backing": "none",
        "text_slots": [
          "line"
        ]
      }
    },
    {
      "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
      "name": "demo-scene",
      "type": "hyperframes:block",
      "title": "Demo Scene",
      "description": "Full-frame demo scene with one headline slot",
      "tags": [
        "demo",
        "scene"
      ],
      "dimensions": {
        "width": 1920,
        "height": 1080
      },
      "duration": 4.0,
      "files": [
        {
          "path": "demo-scene.html",
          "target": "compositions/demo-scene.html",
          "type": "hyperframes:composition"
        }
      ],
      "reels": {
        "kind": "scene",
        "text_slots": [
          "line"
        ]
      }
    },
    {
      "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
      "name": "demo-skip",
      "type": "hyperframes:block",
      "title": "Demo Skip",
      "description": "Broken demo position",
      "tags": [
        "demo",
