      "dimensions": {
        "width": 1920,
        "height": 1080
      },
      "duration": 4.0,
      "files": [
        {
          "path": "demo-skip.html",
          "target": "compositions/demo-skip.html",
          "type": "hyperframes:composition"
        }
      ],
      "reels": {
        "kind": "effect",
        "skip": "их же проверка валит блок под --strict"
