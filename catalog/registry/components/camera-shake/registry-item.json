{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "camera-shake",
  "type": "hyperframes:component",
  "title": "Camera Shake",
  "description": "Procedural handheld, telephoto and rig camera shake for any wrapper: nine measured profiles with per-lens projection, closed-form and seek-safe",
  "tags": [
    "camera",
    "shake",
    "handheld",
    "effect",
    "cinematic"
  ],
  "variables": [
    {
      "id": "shakeProfile",
      "type": "enum",
      "label": "Shake profile",
      "default": "handheld-normal-mild",
      "options": [
        {
          "value": "handheld-normal-mild",
          "label": "Handheld - normal lens, mild"
        },
        {
          "value": "handheld-normal-strong",
          "label": "Handheld - normal lens, strong"
        },
        {
          "value": "handheld-normal-extreme",
          "label": "Handheld - normal lens, extreme"
        },
        {
          "value": "handheld-wideangle-mild",
          "label": "Handheld - wide angle, mild"
        },
        {
          "value": "handheld-wideangle-strong",
          "label": "Handheld - wide angle, strong"
        },
        {
          "value": "handheld-tele-mild",
          "label": "Handheld - telephoto, mild"
        },
        {
          "value": "handheld-tele-strong",
          "label": "Handheld - telephoto, strong"
        },
        {
          "value": "rig-6d-shake",
          "label": "Rig - 6D shake (engine buzz)"
        },
        {
          "value": "rig-6d-wobble",
          "label": "Rig - 6D wobble"
        }
      ]
    },
    {
      "id": "shakeIntensity",
      "type": "number",
      "label": "Intensity multiplier",
      "default": 1,
      "min": 0,
      "max": 3,
      "step": 0.05
    },
    {
      "id": "shakeFrequency",
      "type": "number",
      "label": "Frequency multiplier",
      "default": 1,
      "min": 0.1,
      "max": 4,
      "step": 0.05
    },
    {
      "id": "shakeRotation",
      "type": "boolean",
      "label": "Include rotation (roll + tilt/pan)",
      "default": true
    }
  ],
  "files": [
    {
      "path": "camera-shake.html",
      "target": "compositions/components/camera-shake.html",
      "type": "hyperframes:snippet"
    }
  ],
  "reels": {
    "kind": "effect",
    "mount": "composition",
    "decor_texts": [],
    "text_slots": [],
    "variables": {
      "shakeProfile": {
        "type": "enum",
        "default": "handheld-normal-mild"
      },
      "shakeIntensity": {
        "type": "number",
        "default": 1
      },
      "shakeFrequency": {
        "type": "number",
        "default": 1
      },
      "shakeRotation": {
        "type": "boolean",
        "default": true
      }
    },
    "skip": "`check --strict` на 0.8.27 чист (прежние `composition_file_too_large` и `content_overlap` не воспроизводятся: первый снят маркером реестра). Но в кадре — её собственная инженерная карточка: синяя сетка с домами и служебная строка режима «handheld-normal-mild | 50mm | x1 amp x1 freq | rot on | overscan 1.238», и она же обрезана правым краем вертикального кадра. Это проба тряски, а не картинка ролика. Перепроверено настоящей сборкой на 0.8.27 06.09.2026 (work/skips-recheck/camera-shake)."
  }
}
